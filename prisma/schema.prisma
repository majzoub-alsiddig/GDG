generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  about     String
  photo     String
  category  String
  github    String?
  linkedin  String?
  instagram String?
  twitter   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}