generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  about     String
  photo     String
  category  String
  github    String?
  linkedin  String?
  instagram String?
  twitter   String?
  website   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  category    String
  cover       String
  date        DateTime
  endDate     DateTime?
  location    String
  link        String
  isFeatured  Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, date])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  order     Int      @default(0)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String
  cover       String
  link        String
  categoryId  String
  category    CourseCategory  @relation(fields: [categoryId], references: [id])
  order       Int             @default(0)
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, order])
  @@index([categoryId])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     Json
  author      String
  authorRole  String?
  cover       String
  category    String
  readingTime Int      @default(5)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category])
}
