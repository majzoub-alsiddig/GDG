generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  about     String
  photo     String
  category  String
  github    String?
  linkedin  String?
  instagram String?
  twitter   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  category    String
  cover       String
  date        DateTime
  endDate     DateTime?
  location    String
  link        String
  isFeatured  Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, date])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  cover       String
  link        String
  category    String
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}